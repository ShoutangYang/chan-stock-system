# ============================================================
# 美股/港股通 缠论交易系统 —— Git 忽略规则
# 原则：只入库「源码 + 文档 + 配置」，不入库「运行时生成物」
# ============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/

# ---------- 运行时数据（K线/基本面缓存，20MB+，可随时重新拉取） ----------
data/cache/

# ---------- SQLite 运行时状态（含自选股，属个人数据） ----------
data/*.db
data/*.db-shm
data/*.db-wal
*.sqlite
*.sqlite3

# ---------- 日志 ----------
logs/
*.log

# ---------- 临时探测 / 一次性验证脚本（下划线开头） ----------
_*.py
_*.js
_*.json
_*.csv

# ---------- 编辑器 / 系统 ----------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ---------- 本地覆盖（若存在则不入库） ----------
.env
.env.local
